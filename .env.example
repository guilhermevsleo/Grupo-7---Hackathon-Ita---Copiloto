# Copie para .env e preencha. O arquivo .env nunca deve ir para o repositório, slides ou vídeo.

# Chave da API Gemini (Google AI Studio). Sem ela, o app roda em "modo sem IA" (somente fatos determinísticos).
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Modelo Gemini usado pelo agente ADK. Confirmar o nome do modelo disponível na sua conta.
COPILOTO_GEMINI_MODEL=gemini-3.8-flash
COPILOTO_LLM_TIMEOUT_S=45
# Nível de raciocínio do modelo: minimal | low | medium | high (low = mais rápido para redigir).
COPILOTO_GEMINI_THINKING=low
# Modelos reserva se o principal estiver indisponível (503/429/404), separados por vírgula.
COPILOTO_GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite
# Plano da API: free (padrão no hackathon) ou paid. Aparece na tela e no painel de governança.
COPILOTO_GEMINI_TIER=free

# Base de dados (somente leitura). Se vazio: usa data/synthetic_banking.db (oficial) se existir,
# senão data/demo_synthetic_bank.db (base de demonstração gerada pelo time).
COPILOTO_DB_PATH=

# Segredo do pseudônimo C-XXXX. Se vazio, um segredo local é gerado em data/.pseudonym_secret.
COPILOTO_PSEUDONYM_SECRET=
